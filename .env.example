# Copy to .env and fill in the values you need:  cp .env.example .env
# Never commit your real .env file.

# --- Core ------------------------------------------------------------------
# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# 1 = debug mode with auto-reload (development only — never in production)
FLASK_DEBUG=1
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000
# Optional. Defaults to SQLite at instance/database.db. Example for PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/itihaas
# DATABASE_URL=
# Comma-separated e-mails allowed to open /admin-dashboard
ADMIN_EMAILS=
# Set to 1 when serving over HTTPS
SESSION_COOKIE_SECURE=0
# Maximum upload size in megabytes
MAX_UPLOAD_MB=8

# --- E-mail (sign-up verification codes) ------------------------------------
# For Gmail, create an App Password: https://support.google.com/accounts/answer/185833
# If left empty while FLASK_DEBUG=1, verification codes are printed to the server log.
EMAIL_USER=
EMAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1

# --- Optional integrations ----------------------------------------------------
# Google Maps JavaScript API key for /map (restrict it to your domain in Google Cloud)
GOOGLE_MAPS_API_KEY=
# OpenWeather key for weather in map pop-ups (https://openweathermap.org/api)
OPENWEATHER_API_KEY=
# NewsAPI key for /news (https://newsapi.org/)
NEWS_API_KEY=
# WhatsApp confirmations via pywhatkit (needs a desktop with WhatsApp Web logged in)
WHATSAPP_ENABLED=0
